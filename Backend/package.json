{
  "name": "smart-safety-tour-backend",
  "version": "1.0.0",
  "description": "Backend for Smart Safety Tour App with role-based access",
  "main": "dist/src/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:tests": "tsc -p tsconfig.tests.json",
    "start": "node dist/src/server.js",
    "dev": "nodemon --exec ts-node src/server.ts",
    "test": "npm run build && npm run build:tests && node --test dist/tests/*.test.js",
    "send:gps": "node dist/scripts/send-gps-demo.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.1",
    "express": "^4.19.2",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.1",
    "morgan": "^1.10.2",
    "pg": "^8.4.3",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/helmet": "^0.0.48",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/pg": "^8.20.0",
    "@types/ws": "^8.18.1",
    "nodemon": "^3.1.0",
    "supertest": "^7.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  }
}
